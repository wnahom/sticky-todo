{
  "name": "sticky-todo",
  "version": "1.1.0",
  "description": "桌面磁贴待办清单 - 支持闹钟提醒和全局快捷键",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack:dir": "electron-builder --win --x64 --dir",
    "pack": "electron-builder --win --x64",
    "deploy": "node scripts/deploy.js"
  },
  "build": {
    "appId": "com.stickytodo.app",
    "productName": "StickyTodo",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "styles/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StickyTodo",
      "uninstallDisplayName": "StickyTodo 磁贴待办"
    }
  },
  "license": "MIT",
  "author": "mohan",
  "devDependencies": {
    "electron": "^42.5.0"
  }
}
